{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "guildedsmp:inferno_blade",
        "model": {
          "type": "minecraft:model",
          "model": "guildedsmp:item/inferno_blade"
        }
      },
      {
        "when": "guildedsmp:frostbite",
        "model": {
          "type": "minecraft:model",
          "model": "guildedsmp:item/frostbite"
        }
      },
      {
        "when": "guildedsmp:void_reaper",
        "model": {
          "type": "minecraft:model",
          "model": "guildedsmp:item/void_reaper"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/netherite_sword"
    }
  }
}
